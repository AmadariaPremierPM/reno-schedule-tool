# Copy this file to ".env" and fill in your token.
# Get a personal access token from Smartsheet:
# Account icon (top right) > Apps & Integrations > API Access > Generate new access token
SMARTSHEET_API_TOKEN=your_token_here

# Optional: change the local port (default 3535)
PORT=3535

# Optional: if set, anyone opening the app must enter this password (any
# username, browser's built-in login prompt). Only useful for a hosted
# deployment - leave unset for local use.
APP_PASSWORD=
